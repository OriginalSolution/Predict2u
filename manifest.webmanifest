{
  "name": "Predict2U — Know the Game. Predict Better.",
  "short_name": "Predict2U",
  "description": "Daily football booking codes for Ghana — Safe, Medium and Banker slips on SportyBet, MSport, Betika, football.com and Betpawa. Offline-ready.",
  "id": "./",
  "start_url": "./index.html?source=pwa",
  "scope": "./",
  "lang": "en",
  "dir": "ltr",
  "display": "standalone",
  "display_override": [
    "standalone",
    "minimal-ui"
  ],
  "orientation": "any",
  "background_color": "#08090d",
  "theme_color": "#0a111c",
  "categories": [
    "sports",
    "utilities"
  ],
  "prefer_related_applications": false,
  "launch_handler": {
    "client_mode": [
      "navigate-existing",
      "auto"
    ]
  },
  "icons": [
    {
      "src": "favicon-32x32.png",
      "sizes": "32x32",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "apple-touch-icon.png",
      "sizes": "180x180",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "maskable-icon.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Today’s codes",
      "short_name": "Codes",
      "description": "Open Safe, Medium and Banker slips",
      "url": "./bankers.html?source=shortcut",
      "icons": [
        {
          "src": "icon-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Hot Picks",
      "short_name": "Hot",
      "description": "Most-backed code-hub picks",
      "url": "./hot-picks.html?source=shortcut",
      "icons": [
        {
          "src": "icon-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Track record",
      "short_name": "Record",
      "description": "Settled win rate and ROI",
      "url": "./record.html?source=shortcut",
      "icons": [
        {
          "src": "icon-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Staked codes",
      "short_name": "Staked",
      "description": "Track codes you tapped",
      "url": "./staked.html?source=shortcut",
      "icons": [
        {
          "src": "icon-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    }
  ],
  "share_target": {
    "action": "./share.html",
    "method": "GET",
    "enctype": "application/x-www-form-urlencoded",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url"
    }
  },
  "screenshots": [
    {
      "src": "pwa-splash-v264.jpg",
      "sizes": "720x1279",
      "type": "image/jpeg",
      "form_factor": "narrow",
      "label": "Predict2U branded football and prediction-engine splash"
    }
  ]
}
